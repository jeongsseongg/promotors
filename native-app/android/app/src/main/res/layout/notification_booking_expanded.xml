<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="4dp">
    <TextView android:id="@+id/booking_counts" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:paddingBottom="10dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/booking_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="28sp" android:textStyle="bold" android:fontFamily="sans-serif" android:singleLine="true"/>
        <TextView android:id="@+id/booking_date" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textSize="14sp" android:singleLine="true" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/booking_customer" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="17sp" android:textStyle="bold" android:paddingTop="8dp" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/booking_vehicle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:paddingTop="4dp" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/booking_branch" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:paddingTop="6dp" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/booking_link" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="예약 정보 확인  ›" android:textSize="15sp" android:textStyle="bold" android:paddingTop="12dp"/>
</LinearLayout>
