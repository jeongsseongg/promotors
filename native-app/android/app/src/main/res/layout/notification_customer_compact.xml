<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView style="@style/TextAppearance.Compat.Notification.Title" android:id="@+id/customer_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end"/>
        <Chronometer style="@style/TextAppearance.Compat.Notification.Title" android:id="@+id/customer_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="17sp" android:textStyle="bold" android:singleLine="true"/>
    </LinearLayout>
    <TextView style="@style/TextAppearance.Compat.Notification.Line2" android:id="@+id/customer_vehicle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
